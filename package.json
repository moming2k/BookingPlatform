{
  "name": "booking-platform",
  "version": "1.0.0",
  "description": "Booking platform with payment integration",
  "private": true,
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --outdir=app/assets/builds --public-path=assets",
    "build:css": "tailwindcss -i ./app/assets/stylesheets/application.css -o ./app/assets/builds/application.css --minify",
    "watch": "npm run build -- --watch",
    "watch:css": "npm run build:css -- --watch",
    "dev": "concurrently \"npm run watch\" \"npm run watch:css\"",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report playwright-report"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^7.3.0",
    "@rails/actioncable": "^7.1.0",
    "@stripe/stripe-js": "^2.2.0",
    "alpinejs": "^3.13.3",
    "chart.js": "^4.4.1",
    "flatpickr": "^4.6.13",
    "sweetalert2": "^11.10.1",
    "tippy.js": "^6.3.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "esbuild": "^0.19.10",
    "playwright": "^1.56.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0"
  },
  "main": "index.js",
  "directories": {
    "lib": "lib"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
