<div class="bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">
        Welcome to Booking Platform
      </h1>
      <p class="text-xl text-gray-600 mb-8">
        Book appointments easily with our seamless online booking system
      </p>

      <div class="flex justify-center gap-4">
        <%= link_to "View Services", services_path, class: "btn-primary btn-lg" %>
        <% if user_signed_in? %>
          <%= link_to "My Bookings", bookings_path, class: "btn-outline btn-lg" %>
        <% else %>
          <%= link_to "Sign In", login_path, class: "btn-outline btn-lg" %>
        <% end %>
      </div>
    </div>

    <div class="mt-16">
      <h2 class="text-2xl font-bold text-gray-900 mb-8 text-center">Our Services</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% if @services && @services.any? %>
          <% @services.each do |service| %>
            <div class="card">
              <div class="card-body">
                <h3 class="text-lg font-semibold mb-2"><%= service.name %></h3>
                <p class="text-gray-600 mb-4"><%= service.description %></p>
                <div class="flex justify-between items-center">
                  <span class="text-2xl font-bold text-primary-600">
                    $<%= service.price %>
                  </span>
                  <span class="text-sm text-gray-500">
                    <%= service.duration_minutes %> min
                  </span>
                </div>
                <%= link_to "Book Now", new_booking_path(service_id: service), class: "btn-primary w-full mt-4" %>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="col-span-3 text-center text-gray-500">
            <p>No services available at the moment.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>