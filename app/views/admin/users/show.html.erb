<div class="px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header with Back Button -->
  <div class="mb-8">
    <%= link_to "← Back to Users", admin_users_path(params.permit(:search, :role, :booking_count, :page)), class: "text-primary-600 hover:text-primary-700 mb-4 inline-block" %>
    <div class="flex justify-between items-start">
      <div class="flex items-center space-x-4">
        <div class="h-16 w-16 rounded-full bg-primary-500 flex items-center justify-center text-white text-2xl font-semibold">
          <%= @user.initials %>
        </div>
        <div>
          <h1 class="text-3xl font-bold text-gray-900"><%= @user.name %></h1>
          <p class="mt-1 text-sm text-gray-600"><%= @user.email %></p>
        </div>
      </div>
      <div>
        <% if @user.admin? %>
          <span class="px-4 py-2 text-sm font-semibold rounded-full bg-purple-100 text-purple-800">Admin</span>
        <% else %>
          <span class="px-4 py-2 text-sm font-semibold rounded-full bg-gray-100 text-gray-800">Customer</span>
        <% end %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- User Statistics -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-lg shadow p-6">
          <p class="text-sm font-medium text-gray-600">Total Bookings</p>
          <p class="text-3xl font-bold text-gray-900"><%= @user_stats[:total_bookings] %></p>
        </div>
        <div class="bg-white rounded-lg shadow p-6">
          <p class="text-sm font-medium text-gray-600">Total Spent</p>
          <p class="text-3xl font-bold text-green-600">$<%= number_with_precision(@user_stats[:total_spent], precision: 2) %></p>
        </div>
        <div class="bg-white rounded-lg shadow p-6">
          <p class="text-sm font-medium text-gray-600">Avg Booking Value</p>
          <p class="text-3xl font-bold text-blue-600">$<%= number_with_precision(@user_stats[:avg_booking_value], precision: 2) %></p>
        </div>
        <div class="bg-white rounded-lg shadow p-6">
          <p class="text-sm font-medium text-gray-600">Cancellation Rate</p>
          <p class="text-3xl font-bold text-orange-600"><%= @user_stats[:cancellation_rate] %>%</p>
        </div>
      </div>

      <!-- User Profile -->
      <div class="bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-xl font-bold text-gray-900">Profile Information</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <p class="text-sm font-medium text-gray-500">Name</p>
              <p class="mt-1 text-sm text-gray-900"><%= @user.name %></p>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">Email</p>
              <p class="mt-1 text-sm text-gray-900"><%= @user.email %></p>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">Member Since</p>
              <p class="mt-1 text-sm text-gray-900"><%= @user.created_at.strftime("%B %d, %Y") %></p>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">Role</p>
              <p class="mt-1 text-sm text-gray-900"><%= @user.admin? ? 'Administrator' : 'Customer' %></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Recent Bookings -->
      <div class="bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-xl font-bold text-gray-900">Recent Bookings</h2>
        </div>
        <div class="px-6 py-4">
          <% if @bookings.any? %>
            <div class="space-y-3">
              <% @bookings.each do |booking| %>
                <div class="flex justify-between items-center py-3 border-b last:border-0">
                  <div>
                    <p class="text-sm font-medium text-gray-900"><%= booking.service.name %></p>
                    <p class="text-xs text-gray-500"><%= booking.start_time.strftime("%b %d, %Y at %I:%M %p") %></p>
                  </div>
                  <div class="flex items-center space-x-3">
                    <% case booking.status %>
                    <% when 'confirmed' %>
                      <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Confirmed</span>
                    <% when 'pending' %>
                      <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">Pending</span>
                    <% when 'completed' %>
                      <span class="px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">Completed</span>
                    <% when 'cancelled' %>
                      <span class="px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">Cancelled</span>
                    <% end %>
                    <%= link_to "View", admin_booking_path(booking), class: "text-primary-600 hover:text-primary-900 text-sm" %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-center text-gray-500 py-8">No bookings yet</p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Sidebar Actions -->
    <div class="lg:col-span-1">
      <div class="bg-white rounded-lg shadow sticky top-8">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-xl font-bold text-gray-900">Actions</h2>
        </div>
        <div class="px-6 py-4 space-y-3">
          <% if @user.admin? && @user != current_user %>
            <%= button_to "Revoke Admin", revoke_admin_admin_user_path(@user), method: :post, class: "btn btn-danger w-full", data: { confirm: "Are you sure you want to revoke admin privileges?" } %>
          <% elsif !@user.admin? %>
            <%= button_to "Make Admin", make_admin_admin_user_path(@user), method: :post, class: "btn-primary w-full", data: { confirm: "Are you sure you want to grant admin privileges?" } %>
          <% end %>
          
          <% if @user != current_user %>
            <%= button_to "Impersonate User", impersonate_admin_user_path(@user), method: :post, class: "btn btn-secondary w-full" %>
          <% end %>
          
          <%= link_to "Send Email", "mailto:#{@user.email}", class: "btn btn-secondary w-full text-center" %>
          <%= link_to "View All Bookings", admin_bookings_path(search: @user.email), class: "btn btn-secondary w-full text-center" %>
        </div>
      </div>
    </div>
  </div>
</div>
