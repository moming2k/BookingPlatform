<div class="px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900">Admin Dashboard</h1>
      <p class="mt-2 text-sm text-gray-600">Welcome back, <%= current_user.name %></p>
    </div>

    <!-- Quick Navigation -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
      <%= link_to admin_bookings_path, class: "bg-white rounded-lg shadow p-6 hover:shadow-lg transition-shadow" do %>
        <div class="flex items-center">
          <div class="bg-blue-100 rounded-full p-3 mr-4">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-gray-900">Bookings</h3>
            <p class="text-sm text-gray-600">Manage all bookings</p>
          </div>
        </div>
      <% end %>

      <%= link_to admin_users_path, class: "bg-white rounded-lg shadow p-6 hover:shadow-lg transition-shadow" do %>
        <div class="flex items-center">
          <div class="bg-purple-100 rounded-full p-3 mr-4">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-gray-900">Users</h3>
            <p class="text-sm text-gray-600">Manage users & roles</p>
          </div>
        </div>
      <% end %>

      <%= link_to admin_payments_path, class: "bg-white rounded-lg shadow p-6 hover:shadow-lg transition-shadow" do %>
        <div class="flex items-center">
          <div class="bg-green-100 rounded-full p-3 mr-4">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-gray-900">Payments</h3>
            <p class="text-sm text-gray-600">View revenue & refunds</p>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <!-- Total Bookings -->
      <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-600">Total Bookings</p>
            <p class="text-3xl font-bold text-gray-900"><%= @stats[:total_bookings] %></p>
          </div>
          <div class="bg-blue-100 rounded-full p-3">
            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
        </div>
        <p class="mt-2 text-xs text-gray-500"><%= @stats[:active_bookings] %> active</p>
      </div>

      <!-- Total Revenue -->
      <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-600">Total Revenue</p>
            <p class="text-3xl font-bold text-gray-900">$<%= number_with_precision(@stats[:total_revenue], precision: 2) %></p>
          </div>
          <div class="bg-green-100 rounded-full p-3">
            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
        </div>
        <p class="mt-2 text-xs text-gray-500">$<%= number_with_precision(@stats[:month_revenue], precision: 2) %> this month</p>
      </div>

      <!-- Total Users -->
      <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-600">Total Users</p>
            <p class="text-3xl font-bold text-gray-900"><%= @stats[:total_users] %></p>
          </div>
          <div class="bg-purple-100 rounded-full p-3">
            <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
          </div>
        </div>
        <p class="mt-2 text-xs text-gray-500"><%= @stats[:new_users_this_month] %> new this month</p>
      </div>

      <!-- Active Services -->
      <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-600">Active Services</p>
            <p class="text-3xl font-bold text-gray-900"><%= @stats[:active_services] %></p>
          </div>
          <div class="bg-yellow-100 rounded-full p-3">
            <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
          </div>
        </div>
        <p class="mt-2 text-xs text-gray-500"><%= @stats[:today_bookings] %> bookings today</p>
      </div>
    </div>

    <!-- Next 3 Days Bookings Summary -->
    <div class="bg-white rounded-lg shadow mb-8">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-xl font-bold text-gray-900">Next 3 Days Schedule</h2>
      </div>
      <div class="px-6 py-4">
        <% if @next_three_days_bookings.values.flatten.any? %>
          <% @next_three_days_bookings.each do |date, bookings| %>
            <div class="mb-6 last:mb-0">
              <h3 class="text-lg font-semibold text-gray-800 mb-3 flex items-center">
                <%= date.strftime("%A, %B %d, %Y") %>
                <span class="ml-3 px-2 py-1 text-xs font-medium rounded-full <%= date == Date.current ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-600' %>">
                  <%= bookings.count %> <%= 'booking'.pluralize(bookings.count) %>
                </span>
              </h3>

              <% if bookings.any? %>
                <div class="space-y-2">
                  <% bookings.each do |booking| %>
                    <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                      <div class="flex items-center space-x-4">
                        <div class="text-sm font-medium text-gray-900">
                          <%= booking.start_time.strftime("%I:%M %p") %>
                        </div>
                        <div class="h-8 w-px bg-gray-300"></div>
                        <div>
                          <div class="text-sm font-medium text-gray-900"><%= booking.user.name %></div>
                          <div class="text-xs text-gray-500"><%= booking.service.name %></div>
                        </div>
                      </div>
                      <div class="flex items-center space-x-3">
                        <span class="text-sm font-medium text-gray-700">$<%= number_with_precision(booking.amount, precision: 2) %></span>
                        <% case booking.status %>
                        <% when 'confirmed' %>
                          <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Confirmed</span>
                        <% when 'pending' %>
                          <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">Pending</span>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <p class="text-gray-500 text-sm italic">No bookings scheduled</p>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <p class="text-gray-500 text-center py-8">No bookings scheduled for the next 3 days</p>
        <% end %>
      </div>
    </div>

    <!-- Top Services -->
    <div class="bg-white rounded-lg shadow mb-8">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-xl font-bold text-gray-900">Top Services</h2>
      </div>
      <div class="px-6 py-4">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead>
              <tr>
                <th class="px-6 py-3 bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Service Name</th>
                <th class="px-6 py-3 bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Bookings</th>
                <th class="px-6 py-3 bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Revenue</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @top_services.each do |service| %>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= service[:name] %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= service[:bookings] %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">$<%= number_with_precision(service[:revenue], precision: 2) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
      <!-- Recent Bookings -->
      <div class="bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-xl font-bold text-gray-900">Recent Bookings</h2>
        </div>
        <div class="px-6 py-4">
          <div class="space-y-4">
            <% @recent_bookings.each do |booking| %>
              <div class="flex items-center justify-between py-3 border-b border-gray-100 last:border-0">
                <div>
                  <p class="text-sm font-medium text-gray-900"><%= booking.user.name %></p>
                  <p class="text-xs text-gray-500"><%= booking.service.name %></p>
                  <p class="text-xs text-gray-400"><%= booking.start_time.strftime("%B %d, %Y at %I:%M %p") %></p>
                </div>
                <div class="text-right">
                  <% case booking.status %>
                  <% when 'confirmed' %>
                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Confirmed</span>
                  <% when 'pending' %>
                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">Pending</span>
                  <% when 'cancelled' %>
                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">Cancelled</span>
                  <% when 'completed' %>
                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">Completed</span>
                  <% when 'no_show' %>
                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">No Show</span>
                  <% end %>
                  <p class="text-xs text-gray-500 mt-1">$<%= number_with_precision(booking.amount, precision: 2) %></p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Recent Payments -->
      <div class="bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-xl font-bold text-gray-900">Recent Payments</h2>
        </div>
        <div class="px-6 py-4">
          <div class="space-y-4">
            <% @recent_payments.each do |payment| %>
              <div class="flex items-center justify-between py-3 border-b border-gray-100 last:border-0">
                <div>
                  <p class="text-sm font-medium text-gray-900"><%= payment.user.name %></p>
                  <p class="text-xs text-gray-500">Booking #<%= payment.booking.booking_reference %></p>
                  <p class="text-xs text-gray-400"><%= payment.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
                </div>
                <div class="text-right">
                  <% case payment.status %>
                  <% when 'succeeded' %>
                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Paid</span>
                  <% when 'pending' %>
                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">Pending</span>
                  <% when 'failed' %>
                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">Failed</span>
                  <% when 'refunded' %>
                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-purple-100 text-purple-800">Refunded</span>
                  <% end %>
                  <p class="text-xs text-gray-500 mt-1">$<%= number_with_precision(payment.amount, precision: 2) %></p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Upcoming Bookings -->
    <div class="bg-white rounded-lg shadow">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-xl font-bold text-gray-900">Upcoming Bookings</h2>
      </div>
      <div class="px-6 py-4">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead>
              <tr>
                <th class="px-6 py-3 bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Reference</th>
                <th class="px-6 py-3 bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">User</th>
                <th class="px-6 py-3 bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Service</th>
                <th class="px-6 py-3 bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date & Time</th>
                <th class="px-6 py-3 bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @upcoming_bookings.each do |booking| %>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= booking.booking_reference %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= booking.user.name %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= booking.service.name %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= booking.start_time.strftime("%b %d, %Y %I:%M %p") %></td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <% case booking.status %>
                    <% when 'confirmed' %>
                      <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Confirmed</span>
                    <% when 'pending' %>
                      <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">Pending</span>
                    <% when 'cancelled' %>
                      <span class="px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">Cancelled</span>
                    <% when 'completed' %>
                      <span class="px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">Completed</span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">$<%= number_with_precision(booking.amount, precision: 2) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
</div>
