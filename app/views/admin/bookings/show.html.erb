<div class="px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header with Back Button -->
  <div class="mb-8">
    <%= link_to "← Back to Bookings", admin_bookings_path(params.permit(:search, :status, :date_range, :service_id, :payment_status, :page)), class: "text-primary-600 hover:text-primary-700 mb-4 inline-block" %>
    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Booking #<%= @booking.booking_reference %></h1>
        <p class="mt-2 text-sm text-gray-600">Created <%= @booking.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
      </div>
      <div>
        <% case @booking.status %>
        <% when 'confirmed' %>
          <span class="px-4 py-2 text-sm font-semibold rounded-full bg-green-100 text-green-800">Confirmed</span>
        <% when 'pending' %>
          <span class="px-4 py-2 text-sm font-semibold rounded-full bg-yellow-100 text-yellow-800">Pending</span>
        <% when 'completed' %>
          <span class="px-4 py-2 text-sm font-semibold rounded-full bg-blue-100 text-blue-800">Completed</span>
        <% when 'cancelled' %>
          <span class="px-4 py-2 text-sm font-semibold rounded-full bg-red-100 text-red-800">Cancelled</span>
        <% when 'no_show' %>
          <span class="px-4 py-2 text-sm font-semibold rounded-full bg-gray-100 text-gray-800">No Show</span>
        <% end %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Booking Details -->
      <div class="bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-xl font-bold text-gray-900">Booking Details</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <p class="text-sm font-medium text-gray-500">Service</p>
              <p class="mt-1 text-sm text-gray-900"><%= @booking.service.name %></p>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">Duration</p>
              <p class="mt-1 text-sm text-gray-900"><%= @booking.service.duration_minutes %> minutes</p>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">Date</p>
              <p class="mt-1 text-sm text-gray-900"><%= @booking.start_time.strftime("%A, %B %d, %Y") %></p>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">Time</p>
              <p class="mt-1 text-sm text-gray-900"><%= @booking.start_time.strftime("%I:%M %p") %> - <%= @booking.end_time.strftime("%I:%M %p") %></p>
            </div>
          </div>
          <% if @booking.notes.present? %>
            <div>
              <p class="text-sm font-medium text-gray-500">Notes</p>
              <p class="mt-1 text-sm text-gray-900"><%= @booking.notes %></p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Customer Information -->
      <div class="bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-xl font-bold text-gray-900">Customer Information</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div class="flex items-center space-x-4">
            <div class="h-12 w-12 rounded-full bg-primary-500 flex items-center justify-center text-white font-semibold">
              <%= @booking.user.initials %>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-900"><%= @booking.user.name %></p>
              <p class="text-sm text-gray-500"><%= @booking.user.email %></p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4 pt-4 border-t">
            <div>
              <p class="text-sm font-medium text-gray-500">Total Bookings</p>
              <p class="mt-1 text-sm text-gray-900"><%= @booking.user.bookings.count %></p>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">Member Since</p>
              <p class="mt-1 text-sm text-gray-900"><%= @booking.user.created_at.strftime("%B %Y") %></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Payment Information -->
      <div class="bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-xl font-bold text-gray-900">Payment Information</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <p class="text-sm font-medium text-gray-500">Amount</p>
              <p class="mt-1 text-lg font-bold text-gray-900">$<%= number_with_precision(@booking.amount, precision: 2) %></p>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">Payment Status</p>
              <% if @booking.payment %>
                <% case @booking.payment.status %>
                <% when 'succeeded' %>
                  <span class="mt-1 inline-block px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Paid</span>
                <% when 'refunded' %>
                  <span class="mt-1 inline-block px-2 py-1 text-xs font-semibold rounded-full bg-purple-100 text-purple-800">Refunded</span>
                <% else %>
                  <span class="mt-1 inline-block px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800"><%= @booking.payment.status.titleize %></span>
                <% end %>
              <% else %>
                <p class="mt-1 text-sm text-gray-400">No payment record</p>
              <% end %>
            </div>
          </div>
          <% if @booking.payment %>
            <div class="pt-4 border-t">
              <p class="text-sm font-medium text-gray-500">Transaction ID</p>
              <p class="mt-1 text-sm text-gray-900 font-mono"><%= @booking.payment.stripe_payment_intent_id || 'N/A' %></p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Related Bookings -->
      <% if @related_bookings.any? %>
        <div class="bg-white rounded-lg shadow">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-xl font-bold text-gray-900">Other Bookings by This Customer</h2>
          </div>
          <div class="px-6 py-4">
            <div class="space-y-3">
              <% @related_bookings.each do |booking| %>
                <div class="flex justify-between items-center py-2 border-b last:border-0">
                  <div>
                    <p class="text-sm font-medium text-gray-900"><%= booking.service.name %></p>
                    <p class="text-xs text-gray-500"><%= booking.start_time.strftime("%b %d, %Y at %I:%M %p") %></p>
                  </div>
                  <%= link_to "View", admin_booking_path(booking), class: "text-primary-600 hover:text-primary-900 text-sm" %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Sidebar Actions -->
    <div class="lg:col-span-1">
      <div class="bg-white rounded-lg shadow sticky top-8">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-xl font-bold text-gray-900">Actions</h2>
        </div>
        <div class="px-6 py-4 space-y-3">
          <% if @booking.status == 'pending' %>
            <%= button_to "Confirm Booking", confirm_admin_booking_path(@booking), method: :post, class: "btn-primary w-full" %>
          <% end %>
          
          <% if @booking.status == 'confirmed' %>
            <%= button_to "Mark as Complete", mark_complete_admin_booking_path(@booking), method: :post, class: "btn btn-secondary w-full" %>
            <%= button_to "Mark as No-Show", mark_no_show_admin_booking_path(@booking), method: :post, class: "btn btn-secondary w-full", data: { confirm: "Are you sure?" } %>
          <% end %>
          
          <% if ['pending', 'confirmed'].include?(@booking.status) %>
            <%= button_to "Cancel Booking", cancel_admin_booking_path(@booking), method: :post, class: "btn btn-danger w-full", data: { confirm: "Are you sure you want to cancel this booking?" } %>
          <% end %>
          
          <%= link_to "View Customer Profile", "#", class: "btn btn-secondary w-full text-center" %>
          <%= link_to "Send Email", "mailto:#{@booking.user.email}", class: "btn btn-secondary w-full text-center" %>
        </div>
      </div>
    </div>
  </div>
</div>
