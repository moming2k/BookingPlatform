<div class="px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Bookings Management</h1>
    <p class="mt-2 text-sm text-gray-600">Manage and track all customer bookings</p>
  </div>

  <!-- Statistics Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-sm font-medium text-gray-600">This Month</p>
      <p class="text-3xl font-bold text-gray-900"><%= @stats[:total_bookings] %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-sm font-medium text-gray-600">Pending</p>
      <p class="text-3xl font-bold text-yellow-600"><%= @stats[:pending_confirmations] %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-sm font-medium text-gray-600">Today</p>
      <p class="text-3xl font-bold text-blue-600"><%= @stats[:today_bookings] %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-sm font-medium text-gray-600">Next 7 Days</p>
      <p class="text-3xl font-bold text-green-600"><%= @stats[:upcoming_week] %></p>
    </div>
  </div>

  <!-- Filters and Search -->
  <div class="bg-white rounded-lg shadow mb-6">
    <div class="p-6">
      <%= form_with url: admin_bookings_path, method: :get, class: "space-y-4" do |f| %>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <!-- Search -->
          <div>
            <%= f.label :search, "Search", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :search, value: params[:search], placeholder: "Reference, name, email...", class: "form-input" %>
          </div>

          <!-- Status Filter -->
          <div>
            <%= f.label :status, "Status", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.select :status, 
                options_for_select([
                  ['All Statuses', 'all'],
                  ['Pending', 'pending'],
                  ['Confirmed', 'confirmed'],
                  ['Completed', 'completed'],
                  ['Cancelled', 'cancelled'],
                  ['No Show', 'no_show']
                ], params[:status] || 'all'),
                {}, class: "form-input" %>
          </div>

          <!-- Date Range -->
          <div>
            <%= f.label :date_range, "Date Range", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.select :date_range,
                options_for_select([
                  ['All Time', ''],
                  ['Today', 'today'],
                  ['This Week', 'this_week'],
                  ['This Month', 'this_month']
                ], params[:date_range]),
                {}, class: "form-input" %>
          </div>

          <!-- Actions -->
          <div class="flex items-end space-x-2">
            <%= f.submit "Filter", class: "btn-primary" %>
            <%= link_to "Reset", admin_bookings_path, class: "btn btn-secondary" %>
            <%= link_to "Export CSV", admin_bookings_path(format: :csv, **params.permit(:search, :status, :date_range, :service_id, :payment_status)), class: "btn btn-secondary" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Bookings Table -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Reference</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Customer</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Service</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date & Time</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Payment</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if @bookings.any? %>
            <% @bookings.each do |booking| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= link_to booking.booking_reference, admin_booking_path(booking, params.permit(:search, :status, :date_range, :service_id, :payment_status, :page)), class: "text-primary-600 hover:text-primary-900 font-medium" %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-medium text-gray-900"><%= booking.user.name %></div>
                  <div class="text-sm text-gray-500"><%= booking.user.email %></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <%= booking.service.name %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= booking.start_time.strftime("%b %d, %Y") %><br>
                  <%= booking.start_time.strftime("%I:%M %p") %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  $<%= number_with_precision(booking.amount, precision: 2) %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% case booking.status %>
                  <% when 'confirmed' %>
                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Confirmed</span>
                  <% when 'pending' %>
                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">Pending</span>
                  <% when 'completed' %>
                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">Completed</span>
                  <% when 'cancelled' %>
                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">Cancelled</span>
                  <% when 'no_show' %>
                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">No Show</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if booking.payment %>
                    <% case booking.payment.status %>
                    <% when 'succeeded' %>
                      <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Paid</span>
                    <% when 'refunded' %>
                      <span class="px-2 py-1 text-xs font-semibold rounded-full bg-purple-100 text-purple-800">Refunded</span>
                    <% else %>
                      <span class="px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800"><%= booking.payment.status.titleize %></span>
                    <% end %>
                  <% else %>
                    <span class="text-sm text-gray-400">N/A</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <%= link_to "View", admin_booking_path(booking, params.permit(:search, :status, :date_range, :service_id, :payment_status, :page)), class: "text-primary-600 hover:text-primary-900" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="8" class="px-6 py-12 text-center text-gray-500">
                No bookings found. Try adjusting your filters.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if @bookings.any? %>
      <div class="bg-white px-4 py-3 border-t border-gray-200 sm:px-6">
        <%= paginate @bookings %>
      </div>
    <% end %>
  </div>
</div>
