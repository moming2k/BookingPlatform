<div class="px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Payments & Revenue</h1>
    <p class="mt-2 text-sm text-gray-600">Track payments, revenue, and process refunds</p>
  </div>

  <!-- Revenue Statistics Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-sm font-medium text-gray-600">Total Revenue</p>
      <p class="text-3xl font-bold text-gray-900">$<%= number_with_precision(@stats[:total_revenue], precision: 2) %></p>
      <p class="text-xs text-gray-500 mt-2">All time</p>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-sm font-medium text-gray-600">This Month</p>
      <p class="text-3xl font-bold text-green-600">$<%= number_with_precision(@stats[:month_revenue], precision: 2) %></p>
      <p class="text-xs text-gray-500 mt-2">This Week: $<%= number_with_precision(@stats[:week_revenue], precision: 2) %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-sm font-medium text-gray-600">Today</p>
      <p class="text-3xl font-bold text-blue-600">$<%= number_with_precision(@stats[:today_revenue], precision: 2) %></p>
      <p class="text-xs text-gray-500 mt-2">Avg: $<%= number_with_precision(@stats[:avg_booking_value], precision: 2) %></p>
    </div>
  </div>

  <!-- Filters and Search -->
  <div class="bg-white rounded-lg shadow mb-6">
    <div class="p-6">
      <%= form_with url: admin_payments_path, method: :get, class: "space-y-4" do |f| %>
        <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
          <!-- Search -->
          <div>
            <%= f.label :search, "Search", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :search, value: params[:search], placeholder: "Transaction ID, booking...", class: "form-input" %>
          </div>

          <!-- Status Filter -->
          <div>
            <%= f.label :status, "Status", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.select :status,
                options_for_select([
                  ['All Statuses', 'all'],
                  ['Succeeded', 'succeeded'],
                  ['Pending', 'pending'],
                  ['Failed', 'failed'],
                  ['Refunded', 'refunded']
                ], params[:status] || 'all'),
                {}, class: "form-input" %>
          </div>

          <!-- Date Range -->
          <div>
            <%= f.label :date_range, "Date Range", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.select :date_range,
                options_for_select([
                  ['All Time', ''],
                  ['Today', 'today'],
                  ['This Week', 'this_week'],
                  ['This Month', 'this_month']
                ], params[:date_range]),
                {}, class: "form-input" %>
          </div>

          <!-- Min Amount -->
          <div>
            <%= f.label :min_amount, "Min Amount", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.number_field :min_amount, value: params[:min_amount], placeholder: "0", step: "0.01", class: "form-input" %>
          </div>

          <!-- Actions -->
          <div class="flex items-end space-x-2">
            <%= f.submit "Filter", class: "btn-primary" %>
            <%= link_to "Reset", admin_payments_path, class: "btn btn-secondary" %>
          </div>
        </div>
        <div class="flex justify-end">
          <%= link_to "Export CSV", admin_payments_path(format: :csv, **params.permit(:search, :status, :date_range, :min_amount, :max_amount)), class: "btn btn-secondary" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Payments Table -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Transaction ID</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Booking</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Customer</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if @payments.any? %>
            <% @payments.each do |payment| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-mono text-gray-900">
                    <%= payment.stripe_payment_intent_id&.truncate(20) || 'N/A' %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= link_to payment.booking.booking_reference, admin_booking_path(payment.booking), class: "text-sm text-primary-600 hover:text-primary-900" %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-medium text-gray-900"><%= payment.user.name %></div>
                  <div class="text-sm text-gray-500"><%= payment.user.email %></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900">
                  $<%= number_with_precision(payment.amount, precision: 2) %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% case payment.status %>
                  <% when 'succeeded' %>
                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Paid</span>
                  <% when 'pending' %>
                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">Pending</span>
                  <% when 'failed' %>
                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">Failed</span>
                  <% when 'refunded' %>
                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-purple-100 text-purple-800">Refunded</span>
                  <% else %>
                    <span class="px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800"><%= payment.status.titleize %></span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= payment.created_at.strftime("%b %d, %Y") %><br>
                  <%= payment.created_at.strftime("%I:%M %p") %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <%= link_to "View", admin_payment_path(payment, params.permit(:search, :status, :date_range, :min_amount, :max_amount, :page)), class: "text-primary-600 hover:text-primary-900" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="7" class="px-6 py-12 text-center text-gray-500">
                No payments found. Try adjusting your filters.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if @payments.any? %>
      <div class="bg-white px-4 py-3 border-t border-gray-200 sm:px-6">
        <%= paginate @payments %>
      </div>
    <% end %>
  </div>
</div>
