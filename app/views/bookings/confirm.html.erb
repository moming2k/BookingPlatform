<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="card">
    <div class="card-header">
      <h2 class="text-2xl font-bold">Confirm Your Booking</h2>
      <p class="text-sm text-gray-600 mt-1">Please review your booking details</p>
    </div>

    <div class="card-body">
      <div class="space-y-6">
        <!-- Service Details -->
        <div class="bg-gray-50 p-6 rounded-lg">
          <h3 class="font-semibold text-lg mb-4"><%= @service.name %></h3>

          <div class="space-y-3">
            <div class="flex justify-between">
              <span class="text-gray-600">Date</span>
              <span class="font-semibold"><%= @start_time.strftime("%A, %B %d, %Y") %></span>
            </div>

            <div class="flex justify-between">
              <span class="text-gray-600">Time</span>
              <span class="font-semibold">
                <%= @start_time.strftime("%I:%M %p") %> - <%= @end_time.strftime("%I:%M %p") %>
              </span>
            </div>

            <div class="flex justify-between">
              <span class="text-gray-600">Duration</span>
              <span class="font-semibold"><%= @service.duration_minutes %> minutes</span>
            </div>

            <div class="flex justify-between pt-3 border-t border-gray-200">
              <span class="text-gray-600 font-semibold">Total Price</span>
              <span class="text-2xl font-bold text-primary-600">$<%= @service.price %></span>
            </div>
          </div>
        </div>

        <!-- User Info -->
        <div>
          <h4 class="font-semibold mb-2">Booking for:</h4>
          <p class="text-gray-700">
            <%= current_user.name || current_user.email %>
            <br>
            <span class="text-sm text-gray-500"><%= current_user.email %></span>
          </p>
        </div>

        <!-- Notes -->
        <% if @notes.present? %>
          <div>
            <h4 class="font-semibold mb-2">Additional Notes:</h4>
            <p class="text-gray-700 bg-gray-50 p-3 rounded"><%= @notes %></p>
          </div>
        <% end %>

        <!-- Important Information -->
        <div class="bg-primary-50 border border-primary-200 rounded-lg p-4">
          <h4 class="font-semibold text-primary-900 mb-2">Important Information</h4>
          <ul class="text-sm text-primary-800 space-y-1">
            <li>• You will receive a confirmation email after payment</li>
            <li>• A calendar invite will be sent to your email</li>
            <li>• You can cancel or reschedule up to <%= @service.min_advance_hours %> hours before your appointment</li>
          </ul>
        </div>

        <!-- Action Buttons -->
        <div class="flex gap-4">
          <%= button_to "Confirm & Pay", bookings_path, method: :post, class: "btn-primary flex-1 btn-lg" %>
          <%= link_to "Go Back", new_booking_path(service_id: @service), class: "btn-outline flex-1 btn-lg text-center" %>
        </div>

        <p class="text-xs text-gray-500 text-center">
          By confirming, you agree to our terms of service and cancellation policy
        </p>
      </div>
    </div>
  </div>
</div>