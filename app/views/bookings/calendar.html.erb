<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900">Booking Calendar</h1>
      <p class="text-gray-600 mt-2">View availability across all services</p>
    </div>

    <!-- Service Filter -->
    <div class="mb-6 bg-white rounded-lg shadow-sm border border-gray-200 p-4">
      <label for="service-select" class="block text-sm font-medium text-gray-700 mb-2">
        Select Service
      </label>
      <select id="service-select" class="w-full md:w-64 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
        <% @services.each do |service| %>
          <option value="<%= service.id %>" <%= 'selected' if @selected_service.id == service.id %>>
            <%= service.name %>
          </option>
        <% end %>
      </select>
    </div>

    <!-- Calendar Navigation -->
    <div class="mb-6 bg-white rounded-lg shadow-sm border border-gray-200 p-4">
      <div class="flex items-center justify-between">
        <button id="prev-month" class="btn-outline px-4 py-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>

        <h2 id="calendar-month" class="text-xl font-bold text-gray-900">
          <%= @month.strftime("%B %Y") %>
        </h2>

        <button id="next-month" class="btn-outline px-4 py-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Calendar Grid -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
      <div class="grid grid-cols-7 gap-2 mb-2">
        <% %w[Sun Mon Tue Wed Thu Fri Sat].each do |day| %>
          <div class="text-center text-sm font-semibold text-gray-700 py-2">
            <%= day %>
          </div>
        <% end %>
      </div>

      <div id="calendar-grid" class="grid grid-cols-7 gap-2">
        <%
          start_of_month = @month.beginning_of_month
          start_day = start_of_month.beginning_of_week(:sunday)
          end_of_month = @month.end_of_month
          end_day = end_of_month.end_of_week(:sunday)

          (start_day..end_day).each do |date|
            is_current_month = date.month == @month.month
            is_today = date == Date.current
            is_available = is_current_month && @available_days.include?(date.day)
            is_past = date < Date.current
        %>
          <div class="calendar-day <%= 'other-month' unless is_current_month %>
                                     <%= 'available' if is_available %>
                                     <%= 'today' if is_today %>
                                     <%= 'past' if is_past %>"
               data-date="<%= date.iso8601 %>">
            <div class="day-number"><%= date.day %></div>
            <% if is_available && !is_past %>
              <div class="availability-indicator"></div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Legend -->
    <div class="mt-6 bg-white rounded-lg shadow-sm border border-gray-200 p-4">
      <h3 class="text-sm font-semibold text-gray-900 mb-3">Legend</h3>
      <div class="flex flex-wrap gap-4">
        <div class="flex items-center gap-2">
          <div class="w-4 h-4 bg-green-100 border border-green-300 rounded"></div>
          <span class="text-sm text-gray-700">Available</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-4 h-4 bg-blue-100 border border-blue-300 rounded"></div>
          <span class="text-sm text-gray-700">Today</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-4 h-4 bg-gray-100 border border-gray-300 rounded"></div>
          <span class="text-sm text-gray-700">Unavailable</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .calendar-day {
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    position: relative;
    transition: all 0.2s;
    cursor: default;
  }

  .calendar-day.other-month {
    background-color: #f9fafb;
    opacity: 0.5;
  }

  .calendar-day.past:not(.today) {
    color: #9ca3af;
    background-color: #fafafa;
  }

  .calendar-day.available {
    background-color: #f0fdf4;
    border-color: #86efac;
    cursor: pointer;
  }

  .calendar-day.available:hover {
    background-color: #dcfce7;
    transform: scale(1.05);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .calendar-day.today {
    background-color: #dbeafe;
    border-color: #60a5fa;
    font-weight: 600;
  }

  .calendar-day.today.available {
    background: linear-gradient(135deg, #dbeafe 0%, #dcfce7 100%);
  }

  .day-number {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .availability-indicator {
    width: 6px;
    height: 6px;
    background-color: #22c55e;
    border-radius: 50%;
    margin-top: 0.25rem;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const serviceSelect = document.getElementById('service-select');
    const prevMonthBtn = document.getElementById('prev-month');
    const nextMonthBtn = document.getElementById('next-month');

    // Handle service change
    serviceSelect.addEventListener('change', function() {
      const serviceId = this.value;
      const currentMonth = '<%= @month.strftime("%Y-%m") %>';
      window.location.href = `/calendar?service_id=${serviceId}&month=${currentMonth}`;
    });

    // Handle month navigation
    prevMonthBtn.addEventListener('click', function() {
      const currentMonth = new Date('<%= @month.iso8601 %>');
      currentMonth.setMonth(currentMonth.getMonth() - 1);
      const monthStr = currentMonth.toISOString().slice(0, 7);
      window.location.href = `/calendar?service_id=<%= @selected_service.id %>&month=${monthStr}`;
    });

    nextMonthBtn.addEventListener('click', function() {
      const currentMonth = new Date('<%= @month.iso8601 %>');
      currentMonth.setMonth(currentMonth.getMonth() + 1);
      const monthStr = currentMonth.toISOString().slice(0, 7);
      window.location.href = `/calendar?service_id=<%= @selected_service.id %>&month=${monthStr}`;
    });

    // Handle day click for available dates
    document.querySelectorAll('.calendar-day.available:not(.past)').forEach(day => {
      day.addEventListener('click', function() {
        const date = this.dataset.date;
        window.location.href = `/bookings/new?service_id=<%= @selected_service.id %>&date=${date}`;
      });
    });
  });
</script>
