<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Back Button -->
    <div class="mb-6">
      <%= link_to "← Back to My Bookings", bookings_path, class: "inline-flex items-center text-sm text-gray-600 hover:text-gray-900" %>
    </div>

    <!-- Status Banner -->
    <div class="mb-6">
      <% case @booking.status %>
      <% when 'confirmed' %>
        <div class="bg-green-50 border border-green-200 rounded-lg p-4">
          <div class="flex items-center">
            <svg class="w-6 h-6 text-green-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div>
              <h3 class="font-semibold text-green-900">Booking Confirmed</h3>
              <p class="text-sm text-green-700">Your booking is confirmed and ready</p>
            </div>
          </div>
        </div>
      <% when 'pending' %>
        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
          <div class="flex items-center">
            <svg class="w-6 h-6 text-yellow-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div>
              <h3 class="font-semibold text-yellow-900">Payment Pending</h3>
              <p class="text-sm text-yellow-700">Please complete payment to confirm your booking</p>
            </div>
          </div>
        </div>
      <% when 'cancelled' %>
        <div class="bg-red-50 border border-red-200 rounded-lg p-4">
          <div class="flex items-center">
            <svg class="w-6 h-6 text-red-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div>
              <h3 class="font-semibold text-red-900">Booking Cancelled</h3>
              <p class="text-sm text-red-700">This booking has been cancelled</p>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Main Content -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Booking Details Card -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200">
          <div class="border-b border-gray-200 px-6 py-4">
            <h1 class="text-2xl font-bold text-gray-900">Booking Details</h1>
            <p class="text-sm text-gray-600 mt-1">Reference: <%= @booking.booking_reference %></p>
          </div>

          <div class="px-6 py-6 space-y-6">
            <!-- Service Info -->
            <div>
              <h3 class="text-lg font-semibold text-gray-900 mb-4"><%= @booking.service.name %></h3>
              <p class="text-gray-600"><%= @booking.service.description %></p>
            </div>

            <!-- Date & Time -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="bg-gray-50 p-4 rounded-lg">
                <div class="flex items-center text-gray-600 mb-2">
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                  <span class="text-sm font-medium">Date</span>
                </div>
                <p class="text-lg font-semibold text-gray-900">
                  <%= @booking.start_time.strftime("%A, %B %d, %Y") %>
                </p>
              </div>

              <div class="bg-gray-50 p-4 rounded-lg">
                <div class="flex items-center text-gray-600 mb-2">
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <span class="text-sm font-medium">Time</span>
                </div>
                <p class="text-lg font-semibold text-gray-900">
                  <%= @booking.start_time.strftime("%I:%M %p") %> - <%= @booking.end_time.strftime("%I:%M %p") %>
                </p>
              </div>
            </div>

            <!-- Duration & Price -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-gray-200">
              <div class="flex justify-between items-center">
                <span class="text-gray-600">Duration</span>
                <span class="font-semibold text-gray-900"><%= @booking.service.duration_minutes %> minutes</span>
              </div>

              <div class="flex justify-between items-center">
                <span class="text-gray-600">Price</span>
                <span class="text-xl font-bold text-gray-900">$<%= @booking.amount %></span>
              </div>
            </div>

            <!-- Notes -->
            <% if @booking.notes.present? %>
              <div class="pt-4 border-t border-gray-200">
                <h4 class="font-semibold text-gray-900 mb-2">Additional Notes</h4>
                <p class="text-gray-700 bg-gray-50 p-3 rounded"><%= @booking.notes %></p>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Payment Status Card -->
        <% if @booking.payment.present? %>
          <div class="bg-white rounded-lg shadow-sm border border-gray-200">
            <div class="border-b border-gray-200 px-6 py-4">
              <h2 class="text-xl font-bold text-gray-900">Payment Information</h2>
            </div>

            <div class="px-6 py-6">
              <div class="space-y-3">
                <div class="flex justify-between">
                  <span class="text-gray-600">Status</span>
                  <% case @booking.payment.status %>
                  <% when 'succeeded' %>
                    <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm font-medium">Paid</span>
                  <% when 'pending' %>
                    <span class="px-3 py-1 bg-yellow-100 text-yellow-800 rounded-full text-sm font-medium">Pending</span>
                  <% when 'failed' %>
                    <span class="px-3 py-1 bg-red-100 text-red-800 rounded-full text-sm font-medium">Failed</span>
                  <% end %>
                </div>

                <div class="flex justify-between">
                  <span class="text-gray-600">Amount</span>
                  <span class="font-semibold text-gray-900">$<%= @booking.payment.amount %></span>
                </div>

                <% if @booking.payment.paid_at.present? %>
                  <div class="flex justify-between">
                    <span class="text-gray-600">Paid At</span>
                    <span class="font-semibold text-gray-900">
                      <%= @booking.payment.paid_at.strftime("%B %d, %Y at %I:%M %p") %>
                    </span>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-1">
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 sticky top-6">
          <div class="px-6 py-6 space-y-4">
            <h3 class="font-semibold text-gray-900">Actions</h3>

            <% if @booking.status == 'pending' && @booking.payment.present? %>
              <%= link_to "Complete Payment", booking_payment_path(@booking), class: "btn-primary w-full block text-center" %>
            <% end %>

            <% if @booking.status == 'confirmed' %>
              <button class="btn-outline w-full" onclick="window.print()">
                Download Receipt
              </button>
            <% end %>

            <% if @booking.status != 'cancelled' && @booking.start_time > Time.current %>
              <%= button_to "Cancel Booking", cancel_booking_path(@booking),
                  method: :patch,
                  class: "btn-outline w-full text-red-600 border-red-300 hover:bg-red-50",
                  data: { confirm: "Are you sure you want to cancel this booking?" } %>
            <% end %>

            <div class="pt-4 border-t border-gray-200">
              <h4 class="font-semibold text-gray-900 mb-2 text-sm">Need Help?</h4>
              <p class="text-sm text-gray-600 mb-3">Contact us if you have any questions</p>
              <%= link_to "Contact Support", "#", class: "text-sm text-primary-600 hover:text-primary-700 font-medium" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
