<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="mb-8">
    <%= link_to "← Back to All Services", services_path, class: "text-primary-600 hover:text-primary-700" %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Service Details -->
    <div class="lg:col-span-2">
      <div class="card">
        <div class="card-body">
          <div class="flex items-start justify-between mb-6">
            <div>
              <h1 class="text-3xl font-bold mb-2"><%= @service.name %></h1>
              <% if @service.active %>
                <span class="badge badge-success">Available</span>
              <% else %>
                <span class="badge badge-danger">Unavailable</span>
              <% end %>
            </div>
            <% if @service.color.present? %>
              <div class="w-6 h-6 rounded-full" style="background-color: <%= @service.color %>"></div>
            <% end %>
          </div>

          <div class="prose max-w-none mb-8">
            <h2 class="text-xl font-semibold mb-4">About this service</h2>
            <p class="text-gray-700"><%= @service.description %></p>
          </div>

          <div class="bg-gray-50 p-6 rounded-lg mb-8">
            <h3 class="font-semibold mb-4">Service Details</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <div class="text-sm text-gray-600 mb-1">Duration</div>
                <div class="font-semibold"><%= @service.duration_minutes %> minutes</div>
              </div>

              <div>
                <div class="text-sm text-gray-600 mb-1">Price</div>
                <div class="text-2xl font-bold text-primary-600">$<%= @service.price %></div>
              </div>

              <div>
                <div class="text-sm text-gray-600 mb-1">Minimum Advance Notice</div>
                <div class="font-semibold"><%= @service.min_advance_hours %> hours</div>
              </div>

              <div>
                <div class="text-sm text-gray-600 mb-1">Book Up To</div>
                <div class="font-semibold"><%= @service.max_advance_days %> days ahead</div>
              </div>

              <% if @service.buffer_time_minutes > 0 %>
                <div>
                  <div class="text-sm text-gray-600 mb-1">Buffer Time</div>
                  <div class="font-semibold"><%= @service.buffer_time_minutes %> minutes</div>
                </div>
              <% end %>
            </div>
          </div>

          <div class="mb-8">
            <h3 class="font-semibold mb-4">Availability Schedule</h3>
            <div class="space-y-2">
              <% ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'].each_with_index do |day, index| %>
                <% schedules = @service.availability_schedules.active.where(day_of_week: index) %>
                <div class="flex justify-between items-center py-2 border-b border-gray-200">
                  <span class="font-medium"><%= day %></span>
                  <% if schedules.any? %>
                    <span class="text-success-600">
                      <% schedules.each do |schedule| %>
                        <%= schedule.start_time.strftime("%I:%M %p") %> - <%= schedule.end_time.strftime("%I:%M %p") %>
                      <% end %>
                    </span>
                  <% else %>
                    <span class="text-gray-400">Unavailable</span>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>

          <div>
            <h3 class="font-semibold mb-4">What's Included</h3>
            <ul class="space-y-2">
              <li class="flex items-center text-gray-700">
                <svg class="w-5 h-5 text-success-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                Email confirmation
              </li>
              <li class="flex items-center text-gray-700">
                <svg class="w-5 h-5 text-success-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                Calendar invite
              </li>
              <li class="flex items-center text-gray-700">
                <svg class="w-5 h-5 text-success-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                Reminder notifications
              </li>
              <li class="flex items-center text-gray-700">
                <svg class="w-5 h-5 text-success-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                Free cancellation (<%= @service.min_advance_hours %>h notice required)
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Booking Widget -->
    <div class="lg:col-span-1">
      <div class="card sticky top-8">
        <div class="card-body">
          <div class="text-center mb-6">
            <div class="text-3xl font-bold text-primary-600 mb-2">$<%= @service.price %></div>
            <div class="text-sm text-gray-600"><%= @service.duration_minutes %> minutes</div>
          </div>

          <%= link_to "Book This Service", new_booking_path(service_id: @service), class: "btn-primary w-full btn-lg mb-4" %>

          <div class="text-center">
            <div class="text-sm text-gray-600 mb-2">Next Available</div>
            <% next_slot = @service.next_available_slot %>
            <% if next_slot %>
              <div class="font-semibold text-gray-900">
                <%= Time.parse(next_slot[:start_time].to_s).strftime("%b %d at %I:%M %p") %>
              </div>
            <% else %>
              <div class="text-sm text-gray-500">No upcoming availability</div>
            <% end %>
          </div>

          <div class="mt-6 pt-6 border-t border-gray-200 text-xs text-gray-500 space-y-1">
            <div>✓ Secure payment via Stripe</div>
            <div>✓ Instant confirmation</div>
            <div>✓ Easy rescheduling</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>