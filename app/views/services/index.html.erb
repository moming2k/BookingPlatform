<div class="bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Our Services</h1>
      <p class="text-xl text-gray-600">Choose the service that best fits your needs</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @services.each do |service| %>
        <div class="card hover:shadow-lg transition-shadow">
          <div class="card-body">
            <div class="flex items-start justify-between mb-4">
              <h3 class="text-xl font-semibold"><%= service.name %></h3>
              <% if service.color.present? %>
                <div class="w-3 h-3 rounded-full" style="background-color: <%= service.color %>"></div>
              <% end %>
            </div>

            <p class="text-gray-600 mb-6 flex-grow"><%= service.description %></p>

            <div class="space-y-3 mb-6">
              <div class="flex justify-between items-center text-sm">
                <span class="text-gray-500">Duration</span>
                <span class="font-medium"><%= service.duration_minutes %> min</span>
              </div>

              <div class="flex justify-between items-center">
                <span class="text-gray-500">Price</span>
                <span class="text-2xl font-bold text-primary-600">$<%= service.price %></span>
              </div>

              <div class="text-xs text-gray-500 pt-2 border-t border-gray-200">
                <div>Min. advance: <%= service.min_advance_hours %> hours</div>
                <div>Book up to: <%= service.max_advance_days %> days ahead</div>
              </div>
            </div>

            <div class="space-y-2">
              <%= link_to "Book Now", new_booking_path(service_id: service), class: "btn-primary w-full" %>
              <%= link_to "View Details", service_path(service), class: "btn-outline w-full" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <% if @services.empty? %>
      <div class="text-center py-12">
        <div class="text-gray-400 mb-4">
          <svg class="mx-auto h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
          </svg>
        </div>
        <h3 class="text-lg font-medium text-gray-900 mb-2">No Services Available</h3>
        <p class="text-gray-500">Please check back later for available services.</p>
      </div>
    <% end %>
  </div>
</div>